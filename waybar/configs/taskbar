/* My Mostly Used waybar config incase you wonder :) */
{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "bottom",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 3,
"fixed-center": true,
"ipc": true,
"margin-top": 0,
"margin-left": 0,
"margin-right": 0,

"modules-left": [
        "clock",
        "custom/separator#blank",
        "group/connections",
        "custom/separator#blank",	
        "hyprland/workspaces#numbers",
	],

"modules-center": [
    "mpris",  
	],

"modules-right": [
	"group/notify",
	"battery",
	"group/audio",
    "custom/matuwall",
	"custom/power",
	],
}

